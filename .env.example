# CourtPing local MVP settings
# The app runs with mock in-memory data when Supabase values are absent.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Supabase wiring for later integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio is dry-run by default. Leave this true for local demo.
TWILIO_DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email is a placeholder in this MVP.
EMAIL_FROM=

# Stripe is placeholder/env-gated. Missing keys must not block local demo.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
